# Agent Lab — Environment Variables
# Copy this file to .env and fill in your keys

# LLM Provider API Keys
AGENT_LAB_OPENAI_API_KEY=your-openai-key-here
AGENT_LAB_ANTHROPIC_API_KEY=your-anthropic-key-here
AGENT_LAB_OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: Custom Data Directory (defaults to ~/.agent-lab)
# AGENT_LAB_DATA_DIR=/path/to/data
